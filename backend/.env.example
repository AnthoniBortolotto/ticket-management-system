# Copie para backend/.env: `cp backend/.env.example backend/.env`.
#
# A aplicacao le este arquivo pelo `spring.config.import` do application.yml, e o Docker
# Compose tambem o carrega se existir.
#
# ADMIN_PASSWORD_HASH e a unica variavel obrigatoria: sem ela o boot para, porque a
# migration que semeia o administrador nao teria senha. As demais tem default em
# application.yml.

DB_URL=jdbc:postgresql://localhost:5432/ticketsystem
DB_USER=ticketsystem
DB_PASSWORD=ticketsystem

SERVER_PORT=8080
LOG_LEVEL=INFO

# Primeiro administrador, criado por V3__seed_admin_user.sql na primeira subida.
#
# O hash abaixo e de "admin123" e existe para o projeto rodar sem setup. E um hash
# BCrypt, nao a senha: o SQL nunca ve texto puro. Em qualquer ambiente que nao seja a sua
# maquina, gere outro — a senha deste aqui esta publicada no repositorio.
#
# Para gerar: BCryptPasswordEncoder().encode("a-sua-senha"), ou
# `htpasswd -bnBC 10 "" a-sua-senha | tr -d ':\n'`.
#
# O valor precisa ser um BCrypt completo, de 60 caracteres. Um hash truncado tem o
# prefixo certo, mas o banco recusa e o boot para — de proposito: truncado, ele
# subiria verde e o admin nunca conseguiria entrar.
#
# O nome do administrador nao e variavel: vai literal na migration, porque
# placeholder de Flyway nao escapa nada e um apostrofo quebraria o SQL.
ADMIN_EMAIL=admin@ticketsystem.local
ADMIN_PASSWORD_HASH=$2a$10$TqZk9EsL91XXwsirPJRFpugEf.AsiMXF2h.Pr1z1FQ4GjfCwiHpBC

# Consumidos a partir do modulo auth; ainda nao lidos por nenhuma classe.
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-bytes-em-base64
JWT_EXPIRATION_MINUTES=60
